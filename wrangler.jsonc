{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kivio",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "vars": {
    "BETTER_AUTH_URL": "https://kivio.kjpatel.workers.dev",
    "GOOGLE_CLIENT_ID": "87504852845-lcld8fdmoapd2cdbq8ledat90kdo4fbe.apps.googleusercontent.com",
    "WEBHOOK_URL": "https://kivio.kjpatel.workers.dev"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": true
    }
  }
}
